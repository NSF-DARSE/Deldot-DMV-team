  "drift_warning_thresholds": {
    "ks_statistic": 0.2,
    "absolute_standardized_mean_difference": 0.5,
    "absolute_missing_rate_difference": 0.1
  },
  "release_scope": "Synthetic challenge prototype and real-data shadow validation only; not an autonomous legal or enforcement system."
}
