{
  "version": "final-metrics-v1.0.0",
  "class_order": [
    "review_warranted",
    "review_not_warranted",
    "insufficient_evidence"
  ],
  "primary_metrics": [
    "log_loss",
    "macro_f1",
    "brier_multiclass",
    "ece_10bin"
  ],
  "priority_top_fractions": [0.1, 0.2],
